{
  "name": "claude-adv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adversarial code review and write-capable rescue, powered by Claude. Port of OpenAI's codex-plugin-cc.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/*/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "lint": "biome lint scripts tests",
    "lint:fix": "biome lint --write scripts tests",
    "format": "biome format --write scripts tests",
    "format:check": "biome format scripts tests",
    "check": "biome check scripts tests"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.15"
  }
}
